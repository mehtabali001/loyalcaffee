APP_NAME="Loyal Restaurant & Cafe"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dubai
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite works out of the box; switch to mysql in production
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=loyal_cafe
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@loyalcafe.ae"
MAIL_FROM_NAME="${APP_NAME}"

# First admin account (used by the seeder)
ADMIN_NAME="Loyal Admin"
ADMIN_EMAIL=admin@loyalcafe.ae
ADMIN_PASSWORD=ChangeMe!2026

VITE_APP_NAME="${APP_NAME}"
